{
  "name": "update-dependabot",
  "version": "1.0.0",
  "description": "Renders dependabot.spec.yml to dependabot.yml with current branch and milestone data",
  "main": "src/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "test": "jest",
    "prepare": "cd .. && husky update-dependabot/.husky"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
